<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_red_dim" />
            <stroke android:width="1dp" android:color="@color/danger_red" />
            <corners android:radius="14dp" />
            <padding android:left="14dp" android:top="10dp" android:right="14dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_alt" />
            <stroke android:width="1dp" android:color="@color/danger_red_dim" />
            <corners android:radius="14dp" />
            <padding android:left="14dp" android:top="10dp" android:right="14dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
