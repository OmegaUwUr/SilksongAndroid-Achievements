<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_title" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="20dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_settings_steam" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:paddingTop="16dp" android:paddingBottom="12dp" />
        <Switch android:id="@+id/sw_auto_pull" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_auto_pull" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_auto_pull_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="16dp" android:layout_marginStart="4dp" />
        <Switch android:id="@+id/sw_auto_push" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_auto_push" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_auto_push_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="16dp" android:layout_marginStart="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_settings_gameplay" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:paddingTop="16dp" android:paddingBottom="12dp" />
        <Switch android:id="@+id/sw_skip_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_skip_intro" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_skip_intro_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="16dp" android:layout_marginStart="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_settings_display" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:paddingTop="16dp" android:paddingBottom="12dp" />
        <Switch android:id="@+id/sw_perf_overlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_perf_overlay" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_perf_overlay_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="16dp" android:layout_marginStart="4dp" />
        <Switch android:id="@+id/sw_dual_screen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_dual_screen" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_dual_screen_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="24dp" android:layout_marginStart="4dp" />
        <Button android:id="@+id/btn_advanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_settings_advanced" android:textAllCaps="false" />
        <LinearLayout android:id="@+id/advanced_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/text_dim" android:alpha="0.3" android:layout_marginBottom="16dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical">
                <Button android:id="@+id/btn_clear_build" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_clear_build" android:textSize="15sp" android:textColor="@color/text_primary" android:backgroundTint="@color/hornet_red_dim" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:minHeight="48dp" />
                <Button android:id="@+id/btn_settings_logs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_logs" android:textSize="15sp" android:textColor="@color/text_on_control" android:backgroundTint="@color/surface_control" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:minHeight="48dp" android:layout_marginStart="10dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_clear_build_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginTop="6dp" android:layout_marginBottom="24dp" android:layout_marginStart="4dp" />
        </LinearLayout>
        <Button android:id="@+id/btn_settings_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/settings_back" android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>