<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
      <Button android:id="@+id/btn_settings_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:text="@string/settings_nav_back" android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" android:minHeight="48dp" android:layout_marginStart="0dp" android:textAllCaps="false" android:layout_marginBottom="12dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_title" android:textColor="@color/text_muted" android:textSize="24sp" android:layout_marginBottom="8dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_page_intro" android:textColor="@color/text_muted" android:textSize="14sp" android:layout_marginBottom="8dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginBottom="12dp" android:background="@drawable/launcher_card">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_display_card" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginBottom="8dp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/resolution_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <Switch android:id="@+id/sw_perf_overlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_perf_overlay" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_perf_overlay_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="8dp" android:layout_marginStart="4dp" />
        <Switch android:id="@+id/sw_dual_screen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_dual_screen" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_dual_screen_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="8dp" android:layout_marginStart="4dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginBottom="12dp" android:background="@drawable/launcher_card">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_saves_card" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginBottom="8dp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_cloud_direction" android:textColor="@color/text_muted" android:textSize="14sp" android:layout_marginBottom="8dp" />
        <Switch android:id="@+id/sw_auto_pull" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_auto_pull" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_auto_pull_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="8dp" android:layout_marginStart="4dp" />
        <Switch android:id="@+id/sw_auto_push" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_auto_push" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_auto_push_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="8dp" android:layout_marginStart="4dp" />
        <LinearLayout android:id="@+id/backup_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginBottom="12dp" android:background="@drawable/launcher_card">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_gameplay_card" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginBottom="8dp" android:textStyle="bold" />
        <Switch android:id="@+id/sw_skip_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_skip_intro" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_skip_intro_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginBottom="8dp" android:layout_marginStart="4dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginBottom="12dp" android:background="@drawable/launcher_card">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_achievements_card" android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginBottom="8dp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/achievement_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
      </LinearLayout>
      <Button android:id="@+id/btn_advanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_settings_advanced" android:textAllCaps="false" />
      <LinearLayout android:id="@+id/advanced_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="12dp" android:background="@drawable/launcher_card" android:layout_marginBottom="12dp">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/text_dim" android:alpha="0.3" android:layout_marginBottom="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical">
          <Button android:id="@+id/btn_clear_build" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_clear_build" android:textSize="15sp" android:textColor="@color/text_primary" android:backgroundTint="@color/hornet_red_dim" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:minHeight="48dp" android:layout_marginStart="0dp" android:textAllCaps="false" />
          <Button android:id="@+id/btn_settings_logs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_logs" android:textSize="15sp" android:textColor="@color/text_on_control" android:backgroundTint="@color/surface_control" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:minHeight="48dp" android:layout_marginStart="0dp" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_clear_build_subtitle" android:textColor="@color/text_dim" android:textSize="14sp" android:layout_marginTop="6dp" android:layout_marginBottom="24dp" android:layout_marginStart="4dp" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>