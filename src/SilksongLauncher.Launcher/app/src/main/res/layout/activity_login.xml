<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface"
        android:gravity="center_horizontal"
        android:id="@+id/login_columns">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:id="@+id/login_form">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_password_hint"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />
            <EditText
                android:id="@+id/edit_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_username"
                android:autofillHints="username"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp"
                android:minHeight="48dp"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edit_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_password"
                android:autofillHints="password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp"
                android:minHeight="48dp"
                android:layout_marginBottom="8dp"
                android:saveEnabled="false" />
            <LinearLayout
                android:id="@+id/row_guard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginBottom="8dp">
                <EditText
                    android:id="@+id/edit_guard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/login_guard_hint"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="14sp"
                    android:minHeight="48dp"
                    android:saveEnabled="false" />
                <Button
                    android:id="@+id/btn_guard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_guard_submit"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_sign_in"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/login_sign_in"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:minHeight="48dp"
                    android:layout_weight="1" />
                <Button
                    android:id="@+id/btn_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/login_cancel"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/txt_login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_status_connecting"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/login_qr_panel"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal">
            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:background="@color/text_primary"
                android:id="@+id/login_qr_frame">
                <ImageView
                    android:id="@+id/img_qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/login_subtitle" />
                <ProgressBar
                    android:id="@+id/login_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
