<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/launch_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/launcher_card">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/launcher_mark"
                    android:contentDescription="Silksong"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hollow Knight: Silksong"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANDROID • STEAM CLOUD • ACHIEVEMENTS"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_login_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/launcher_card"
                android:textColor="@color/status_green"
                android:textSize="12sp"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.60"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAY"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_launch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:background="@drawable/launcher_primary"
                    android:foreground="@drawable/focus_on_dark"
                    android:text="▶   Play Silksong"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:focusedByDefault="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT &amp; SAVES"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:background="@drawable/launcher_card"
                    android:foreground="@drawable/focus_on_dark"
                    android:text="@string/action_log_in"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:gravity="center_vertical|start"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp">

                        <Button
                            android:id="@+id/btn_pull"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:background="@drawable/launcher_card"
                            android:foreground="@drawable/focus_on_dark"
                            android:text="@string/action_pull_saves"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textAllCaps="false"
                            android:padding="16dp"
                            android:enabled="false" />

                        <ProgressBar
                            android:id="@+id/spin_pull"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="14dp"
                            android:indeterminateTint="@color/text_primary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/btn_push"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:background="@drawable/launcher_card"
                            android:foreground="@drawable/focus_on_dark"
                            android:text="@string/action_push_saves"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textAllCaps="false"
                            android:padding="16dp"
                            android:enabled="false" />

                        <ProgressBar
                            android:id="@+id/spin_push"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="14dp"
                            android:indeterminateTint="@color/text_primary"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <dev.silksong.launcher.SaveHistoryButton
                    android:id="@+id/btn_save_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:background="@drawable/launcher_card"
                    android:foreground="@drawable/focus_on_dark"
                    android:text="↶  Steam Save History"
                    android:textColor="@color/status_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:gravity="center_vertical|start"
                    android:padding="16dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:minHeight="0dp"
                        android:background="@drawable/launcher_card"
                        android:foreground="@drawable/focus_on_dark"
                        android:text="⚙  Game settings"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:padding="16dp" />

                    <Button
                        android:id="@+id/btn_logs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="0dp"
                        android:background="@drawable/launcher_card"
                        android:foreground="@drawable/focus_on_dark"
                        android:text="ⓘ  Logs &amp; diagnostics"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:padding="16dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <dev.silksong.launcher.ExitButton
                    android:id="@+id/btn_exit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:background="@drawable/launcher_exit"
                    android:foreground="@drawable/focus_on_dark"
                    android:text="⏻   Exit launcher safely"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.40"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/launcher_card"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="●  Steam achievements"
                        android:textColor="@color/status_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Persistent notification shows when the Steam synchronization service is active."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/launcher_card"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="☁  Steam Cloud"
                        android:textColor="@color/status_blue"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Current saves sync normally. Steam Save History opens Restore_Points backups separately."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/launcher_card"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="LIVE ACTIVITY"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="8dp" />

                    <ScrollView
                        android:id="@+id/log_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:scrollbars="vertical"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:descendantFocusability="blocksDescendants">

                        <TextView
                            android:id="@+id/txt_log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/launcher_status_idle"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="2dp"
                            android:focusable="false" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
