<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/launch_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingTop="12dp"
                android:paddingRight="14dp"
                android:paddingBottom="18dp">

                <!-- Single launcher header. Settings live only in the Game Settings card below. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/launcher_card"
                        android:clipToOutline="true">

                        <dev.silksong.launcher.OfficialSteamAssetView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="4dp"
                            android:tag="ic_launcher"
                            android:contentDescription="Hollow Knight Silksong"
                            android:scaleType="centerCrop" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SILKSONG ANDROID"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Steam launcher"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Official Steam artwork. The image determines this frame's height from
                     its real intrinsic aspect ratio; no fixed-height center crop. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="108dp"
                    android:background="@drawable/launcher_hero_frame"
                    android:clipToOutline="true">

                    <dev.silksong.launcher.OfficialSteamAssetView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:tag="launcher_hero"
                        android:contentDescription="Official Hollow Knight Silksong artwork"
                        android:scaleType="fitCenter" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/launcher_hero_scrim" />

                    <dev.silksong.launcher.OfficialSteamAssetView
                        android:layout_width="160dp"
                        android:layout_height="64dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="10dp"
                        android:tag="launcher_logo"
                        android:contentDescription="Hollow Knight Silksong logo"
                        android:scaleType="fitStart" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="10dp"
                        android:text="EXPLORE\nFIGHT\nDISCOVER\nASCEND"
                        android:textAlignment="viewEnd"
                        android:gravity="end"
                        android:textColor="#D9F7F8FA"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.16"
                        android:lineSpacingExtra="1dp" />
                </FrameLayout>

                <Button
                    android:id="@+id/btn_launch"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="9dp"
                    android:minHeight="0dp"
                    android:background="@drawable/launcher_primary"
                    android:foreground="@drawable/focus_on_dark"
                    android:text="▶   Play Game"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:focusedByDefault="true" />

                <!-- Steam account -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="7dp"
                    android:background="@drawable/launcher_card">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="13dp"
                        android:padding="1dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dashboard_steam"
                        android:contentDescription="Steam" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="58dp"
                        android:paddingEnd="42dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Steam"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_login_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not signed in"
                            android:textColor="@color/status_green"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_dashboard_chevron"
                        android:contentDescription="Open" />

                    <Button
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/focus_on_dark"
                        android:text="@string/action_log_in"
                        android:textColor="@android:color/transparent"
                        android:textSize="1sp"
                        android:textAllCaps="false"
                        android:contentDescription="Steam account" />
                </FrameLayout>

                <!-- Steam Cloud actions -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="7dp"
                    android:background="@drawable/launcher_card">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="15dp"
                        android:src="@drawable/ic_dashboard_cloud"
                        android:contentDescription="Cloud saves" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="58dp"
                        android:paddingEnd="42dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cloud Saves"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pull, push, and restore Steam history"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_dashboard_chevron"
                        android:contentDescription="Open" />

                    <dev.silksong.launcher.CloudMenuButton
                        android:id="@+id/btn_cloud"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/focus_on_dark"
                        android:text=""
                        android:stateListAnimator="@null"
                        android:contentDescription="Steam Cloud saves" />
                </FrameLayout>

                <!-- GameNative-inspired preview; attribution in CREDITS.md. -->
                <dev.silksong.launcher.AchievementPreviewView
                    android:id="@+id/btn_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp" />

                <!-- Game settings: the only settings entry on the dashboard. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="7dp"
                    android:background="@drawable/launcher_card">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="15dp"
                        android:src="@drawable/ic_dashboard_gamepad"
                        android:contentDescription="Game settings" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="58dp"
                        android:paddingEnd="42dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Game Settings"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Controls, performance, display and launcher options"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_dashboard_chevron"
                        android:contentDescription="Open" />

                    <Button
                        android:id="@+id/btn_settings"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/focus_on_dark"
                        android:text=""
                        android:stateListAnimator="@null"
                        android:textAllCaps="false"
                        android:contentDescription="Game settings" />
                </FrameLayout>

                <!-- About -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/launcher_card">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="15dp"
                        android:src="@drawable/ic_dashboard_info"
                        android:contentDescription="About" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="58dp"
                        android:paddingEnd="42dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="About"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Version, credits and diagnostics"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_dashboard_chevron"
                        android:contentDescription="Open" />

                    <dev.silksong.launcher.AboutButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/focus_on_dark"
                        android:text=""
                        android:stateListAnimator="@null"
                        android:contentDescription="About Silksong Android" />
                </FrameLayout>

                <dev.silksong.launcher.ExitButton
                    android:id="@+id/btn_exit"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:minHeight="0dp"
                    android:background="@drawable/launcher_exit"
                    android:foreground="@drawable/focus_on_dark"
                    android:drawableStart="@drawable/ic_dashboard_exit"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Exit launcher safely"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="S I L K S O N G   A N D R O I D   •   P L A Y   A N Y W H E R E"
                    android:textColor="@color/text_dim"
                    android:textSize="8sp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Concrete Pull / Push actions and the live log stay in the hierarchy
             for LauncherActivity and the Cloud dialog, but never overlap the dashboard. -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_pull"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:text="@string/action_pull_saves"
                android:enabled="false" />

            <Button
                android:id="@+id/btn_push"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:text="@string/action_push_saves"
                android:enabled="false" />

            <ProgressBar
                android:id="@+id/spin_pull"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/spin_push"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="1dp"
                android:layout_height="1dp">

                <TextView
                    android:id="@+id/txt_log"
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_status_idle" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
