    <string name="options_lifecycle">Check after scenes, saves, and resume</string>
    <string name="options_periodic">Enable periodic missed-achievement check</string>
    <string name="options_award_event">Enable extra award-event listener</string>
    <string name="options_popups">Show confirmed achievement popups</string>
    <string name="options_interval">Periodic check interval</string>
    <string-array name="options_intervals"><item>Every 60 seconds</item><item>Every 120 seconds (default)</item><item>Every 5 minutes</item><item>Every 10 minutes</item></string-array>
