             // game promotes a stranded save temp over the real save without
diff -ruN '--exclude=.github' '--exclude=BUILD_APK.md' orig_src/SilksongAndroid-1.0.3/tools/docker/apk.Dockerfile mod_src/SilksongAndroid-1.0.3/tools/docker/apk.Dockerfile
