<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The build stages Silksong's official Steam desktop/client icon into
         ic_launcher_bg.png. Keep the artwork on the foreground layer so
         Android's adaptive-icon safe-zone inset protects it from circular,
         squircle, and OEM launcher masks. -->
    <background android:drawable="@android:color/black" />
    <foreground android:drawable="@mipmap/ic_launcher_bg" />
</adaptive-icon>
